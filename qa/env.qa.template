# orcaclubpro overrides for ccqa (same format as ~/dev/orca/qa/tools/env.qa.template). Dummy values ONLY.
# OAuth tests expect the production issuer; QA's NEXT_PUBLIC_SERVER_URL points at the local QA server.
OAUTH_ISSUER=https://orcaclub.pro
# /api/booking builds its Resend client at module load, so the build needs a non-empty key. Dummy: no mail is sent.
RESEND_API_KEY=re_qa_dummy_not_a_real_key
